{
  "name": "luna-holdem",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browser Texas Hold'em with OpenAI GPT-5.6 Luna opponents.",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
