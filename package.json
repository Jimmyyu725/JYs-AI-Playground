    "api:check": "node scripts/check-openai.js",
    "ui:check": "node scripts/check-ui.js",
    "flow:check": "node scripts/check-game-flow.js"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "express": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright-core": "^1.62.0"
  }
